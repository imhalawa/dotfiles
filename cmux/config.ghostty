# cmux terminal — typography and layout only.
# Colors are NOT set here: Claude Code paints its own pane via
# ~/.claude/hooks/paper-theme.sh (OSC escapes). Other panes keep cmux's
# default theme, which follows the system light/dark mode.
#
# WARNING: `cmux themes set` rewrites this whole file. Re-apply from
# ~/dotfiles/cmux/config.ghostty if that happens.

# Terminal default for non-Claude panes. Claude panes are repainted by
# ~/.claude/hooks/paper-theme.sh regardless of this.
# High-contrast black. Palette is hand-set: Selenized Dark's colors are
# tuned for #103C48 and go muddy on pure black.
background = #000000
foreground = #F2F2F2
cursor-color = #FFFFFF

# floor the contrast of any color the app picks against the background
minimum-contrast = 4.5

palette = 0=#5C6370
palette = 1=#FF6B60
palette = 2=#7FE787
palette = 3=#FFD866
palette = 4=#6FB6FF
palette = 5=#FF8AD8
palette = 6=#5BE7DA
palette = 7=#E6E6E6
palette = 8=#7A8290
palette = 9=#FF8B80
palette = 10=#A2F5A8
palette = 11=#FFE28A
palette = 12=#9CCDFF
palette = 13=#FFA9E4
palette = 14=#86F2E8
palette = 15=#FFFFFF

# alts: RecMonoCasual / RecMonoLinear / RecMonoDuotone / AtkynsonMono Nerd Font Mono
font-family = RecMonoSmCasual Nerd Font Mono
font-size = 15
font-thicken = true
font-feature = -calt,-liga,-dlig
adjust-cell-height = 22%

# never dim text
faint-opacity = 1
unfocused-split-opacity = 1

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# cmux-only key (ignored by the bundled ghostty CLI)
surface-tab-bar-font-size = 15
