{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "customSidebars": {
    "renderer": "inProcess"
  },
  "schemaVersion": 1,
  "app": {
    "appearance": "light"
  },
  "sidebarAppearance": {
    "matchTerminalBackground": true
  },
  "paneBorderColor": "#B4AEA2",
  "activePaneBorderColor": null,
  "terminal": {
    "showScrollBar": false
  }
}